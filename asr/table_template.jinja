<table style="border-collapse: collapse; width: auto;">
<thead>
<tr>
<th>Model</th>
{% for col in cols %}<th>{{ col_labels.get(col, col) }}</th>{% endfor %}
</tr>
</thead>
<tbody>
{% for row in rows %}
<tr>
<td>{{ row.model }}</td>
{% for col in cols %}<td>{{ row[col] | fmt }}</td>{% endfor %}
</tr>
{% endfor %}
</tbody>
</table>
