<style>
  .charts-wrapper {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .chart-panel {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 20px 22px 16px;
    flex: 1;
    min-width: 360px;
    box-sizing: border-box;
  }
  .chart-title {
    font-weight: 700;
    font-size: 14.5px;
    margin: 0 0 2px;
    color: #1a1a1a;
  }
  .chart-subtitle {
    color: #c62828;
    font-size: 12px;
    text-align: center;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .chart-body {
    position: relative;
    margin-top: 20px;
  }
  .chart-row {
    display: flex;
    align-items: center;
    height: 23px;
    margin-bottom: 2px;
  }
  .row-label {
    width: 182px;
    min-width: 182px;
    text-align: right;
    font-size: 12px;
    padding-right: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #333;
  }
  .bar-area {
    flex: 1;
    height: 100%;
    background: #ececec;
    border-radius: 2px;
    position: relative;
    overflow: visible;
  }
  .bar {
    height: 100%;
    border-radius: 2px;
    min-width: 3px;
  }
  .row-value {
    width: 48px;
    min-width: 48px;
    font-size: 12px;
    color: #555;
    padding-left: 6px;
    text-align: left;
  }
  .threshold-line {
    position: absolute;
    top: -18px;
    bottom: 0;
    width: 0;
    border-left: 2px dashed #c62828;
    z-index: 5;
    pointer-events: none;
    display: none;
  }
  .threshold-line-label {
    position: absolute;
    top: 0;
    left: 5px;
    font-size: 11px;
    color: #c62828;
    white-space: nowrap;
    font-weight: 600;
    line-height: 1;
  }
  .chart-caption {
    font-size: 11px;
    color: #777;
    font-style: italic;
    margin: 10px 0 0;
  }
</style>
<div class="charts-wrapper">
  {% for chart in charts %}
  <div class="chart-panel" data-threshold-pct="{{ "%.4f" | format(chart.threshold_pct) }}">
    <div class="chart-title">{{ chart.title }}</div>
    {% if chart.subtitle %}<div class="chart-subtitle">{{ chart.subtitle }}</div>{% endif %}
    <div class="chart-body">
      <div class="threshold-line">
        {% if chart.threshold_label %}<span class="threshold-line-label">{{ chart.threshold_label }}</span>{% endif %}
      </div>
      {% for row in chart.rows %}
      <div class="chart-row">
        <div class="row-label" title="{{ row.label }}">{% if row.cloud %}<b>{{ row.label }}</b>{% else %}{{ row.label }}{% endif %}</div>
        <div class="bar-area">
          <div class="bar" style="width: {{ "%.2f" | format(row.bar_pct) }}%; background-color: {{ row.color }};"></div>
        </div>
        <div class="row-value">{{ row.display }}</div>
      </div>
      {% endfor %}
    </div>
    <p class="chart-caption"><em>{{ chart.caption }}</em></p>
  </div>
  {% endfor %}
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.chart-panel').forEach(function (panel) {
    var thresholdPct = parseFloat(panel.dataset.thresholdPct);
    var barAreas = panel.querySelectorAll('.bar-area');
    var line = panel.querySelector('.threshold-line');
    var body = panel.querySelector('.chart-body');
    if (!barAreas.length || !line || !body) return;
    var firstBar = barAreas[0];
    var bodyRect = body.getBoundingClientRect();
    var barRect = firstBar.getBoundingClientRect();
    var lineX = (barRect.left - bodyRect.left) + (thresholdPct / 100) * barRect.width;
    line.style.left = lineX + 'px';
    line.style.display = 'block';
  });
});
</script>
